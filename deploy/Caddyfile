{
	email {$ACME_EMAIL}
}

{$API_HOST} {
	encode gzip
	# Five POSTs a minute per client address, in front of the API limiter.
	# The module sets Retry-After. The error route keeps a Retry-After on the JSON 429.
	rate_limit {
		zone closed_test {
			match {
				method POST
				path /api/auth/sign-in/* /api/signup /api/invites
			}
			key {remote_host}
			events 5
			window 1m
		}
	}
	# The API takes its URL from BETTER_AUTH_URL. It reads X-Forwarded-For
	# only when the peer is this container (172.28.19.10).
	reverse_proxy api:8787
	handle_errors {
		@too_many expression `{http.error.status_code} == 429`
		handle @too_many {
			header Content-Type "application/json; charset=utf-8"
			header Retry-After "60"
			header Cache-Control "no-store"
			respond `{"error":"Too many attempts. Wait and try again."}` 429
		}
	}
}
