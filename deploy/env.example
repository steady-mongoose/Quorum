# Copy to deploy/.env on the VPS. Do not commit the copy.
# POSTGRES_PASSWORD must be URL-safe (letters and digits) because it is placed in DATABASE_URL.

POSTGRES_USER=avouch
POSTGRES_PASSWORD=
POSTGRES_DB=avouch

# 32 or more random characters. Generate on the box: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.avouchsocial.com
WEB_ORIGINS=https://avouchsocial.com,https://www.avouchsocial.com

API_HOST=api.avouchsocial.com
ACME_EMAIL=

# Seats Josh once. Josh, 1, or true. Leave blank until you are ready to run scripts/seed-owner.sh.
# The seed removes BOOTSTRAP_OWNER_PASSWORD from this file after it succeeds.
BOOTSTRAP_OWNER=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# Caddy's address on the compose network. Do not add other addresses.
TRUSTED_PROXIES=172.28.19.10

BACKUP_DIR=/var/backups/avouch
# age public key only. Generate the identity on a machine that is not this VPS:
#   age-keygen -o avouch-backup-identity.txt
# Put the age1... line here. Do not put the AGE-SECRET-KEY line on the server.
BACKUP_AGE_RECIPIENT=
# Off-site copy stays off until all four values are set. Josh approves the bucket first.
# R2: https://<accountid>.r2.cloudflarestorage.com  S3: an endpoint that supports object lock.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# COMPLIANCE, GOVERNANCE, or off. Retain-until matches BACKUP_RETENTION_DAYS.
BACKUP_S3_OBJECT_LOCK=COMPLIANCE
BACKUP_RETENTION_DAYS=14

# Picture and video storage. Leave every value blank until you approve a store
# you pay for, or a store you run yourself. Blank keeps uploads off.
# Do not use AWS, Google, Azure, or Apple. An S3-compatible endpoint is enough.
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_BUCKET=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_FORCE_PATH_STYLE=true
# Video stays off until the $250 band is boring. Set this to on only then.
# MEDIA_VIDEO=off
