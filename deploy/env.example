# Copy to deploy/.env on the VPS. Do not commit the copy.
# POSTGRES_PASSWORD must be URL-safe (letters and digits) because it is placed in DATABASE_URL.

POSTGRES_USER=avouch
POSTGRES_PASSWORD=
POSTGRES_DB=avouch

# 32 or more random characters. Generate on the box: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Seals a CSAM hold. Use a random 32-byte key (`openssl rand -hex 32`) or a
# passphrase of 16 or more characters. A passphrase is derived with HKDF-SHA256.
# Leave this blank and the server still boots. A CSAM removal still hides the
# post and its files, records the removal and the ban, and alerts an admin.
# It only skips the encrypted copy.
# CSAM_HOLD_KEY=
# Days to keep a hold. Pending counsel. The default is 365 and a lower value
# is raised to 365. Recording a CyberTipline filing extends the hold from that date.
# CSAM_HOLD_DAYS=365
BETTER_AUTH_URL=https://api.avouchsocial.com
WEB_ORIGINS=https://avouchsocial.com,https://www.avouchsocial.com

API_HOST=api.avouchsocial.com
ACME_EMAIL=

# Leave these blank. scripts/seed-owner.sh reads them from the environment, or
# prompts, and passes them with docker compose exec -e. It does not write the
# password here. A password left in this file is cleared after a successful seat.
BOOTSTRAP_OWNER=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# Caddy's address on the compose network. Do not add other addresses.
TRUSTED_PROXIES=172.28.19.10

BACKUP_DIR=/var/backups/avouch
# age public key only. Generate the identity on a machine that is not this VPS:
#   age-keygen -o avouch-backup-identity.txt
# Put the age1... line here. Do not put the AGE-SECRET-KEY line on the server.
BACKUP_AGE_RECIPIENT=
# Off-site copy stays off until all four values are set. Josh approves the bucket first.
# R2: https://<accountid>.r2.cloudflarestorage.com  S3: an endpoint that supports object lock.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# COMPLIANCE, GOVERNANCE, or off. Retain-until matches BACKUP_RETENTION_DAYS.
BACKUP_S3_OBJECT_LOCK=COMPLIANCE
BACKUP_RETENTION_DAYS=14
# Success ping after a nightly backup. A failed run pings this URL with /fail
# appended. Leave blank to disable. The value is not printed or passed on curl's
# command line. Healthchecks.io: use the check URL, not the /fail URL.
BACKUP_HEALTHCHECK_URL=

# Picture and video storage. Leave every value blank until you approve a store
# you pay for, or a store you run yourself. Blank keeps uploads off.
# Do not use AWS, Google, Azure, or Apple. An S3-compatible endpoint is enough.
# The host must not be avouchsocial.com or a subdomain of it. That origin must
# send X-Content-Type-Options: nosniff.
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_HOST=
# MEDIA_S3_PORT=443
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_BUCKET=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_FORCE_PATH_STYLE=true
# Video stays off until the $250 band is boring. Set this to on only then.
# MEDIA_VIDEO=off
# Live room calls. Leave CALLS blank until you want the button to appear.
# CALLS=on shows it. There is no recording. See deploy/README.md.
# CALLS=
# CALLS_STUN_URLS=
# CALLS_TURN_URLS=
# 32 or more letters and digits. openssl rand -hex 32. Shared with the calls profile.
# CALLS_TURN_SECRET=
# CALLS_TURN_EXTERNAL_IP=
# CALLS_TURN_REALM=avouchsocial.com
# Password for the media_worker login. Letters and digits, 16 or more.
# Set it before applying migrations/0007_media_worker_role.sql. That file needs your approval.
# MEDIA_WORKER_DB_PASSWORD=
