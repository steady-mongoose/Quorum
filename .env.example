
# The platform is invite-only. The first member on a box uses this code and becomes a steward.
# Change it before anyone else can reach the box.
VITE_FOUNDER_CODE=FOUNDER

# Origin of the API on the dedicated box. Empty keeps same-origin paths, which
# is what local dev uses. The static site on Cloudflare should set this at
# build time once the box is up, for example https://api.avouchsocial.com
# (no trailing slash). A missing or HTML response is treated as unavailable
# and does not crash the page. When this is empty, or the API does not
# answer, the site stays in demo mode.
VITE_API_BASE_URL=

# Dedicated-box API. These are not baked into the static site.
# Fill them in deploy/.env on the VPS. See deploy/README.md.
# DATABASE_URL=postgres://avouch:password@127.0.0.1:5432/avouch
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://api.avouchsocial.com
# WEB_ORIGINS=https://avouchsocial.com,https://www.avouchsocial.com
# BOOTSTRAP_OWNER=Josh
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_PASSWORD=

# Picture and video storage. Leave these blank until you approve the spend.
# Blank keeps uploads off. See deploy/README.md. Video stays off unless
# MEDIA_VIDEO=on. The charter keeps video off until the $250 band is boring.
# The endpoint host must not be avouchsocial.com or a subdomain of it.
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_BUCKET=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_FORCE_PATH_STYLE=true
# MEDIA_VIDEO=off
